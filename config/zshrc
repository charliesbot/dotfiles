# Bookmark management
alias jbl='jj bookmark list'
alias jbc='jj bookmark create'
alias jbm='jj bookmark move'
alias jbd='jj bookmark delete'

 jpm() {
    if [[ $# -ne 1 ]]; then
      echo "Usage: jpm <pr-number-or-url>"
      return 2
    fi

    local pr="$1"
    local info number base head state next_prs

    info=$(gh pr view "$pr" --json number,baseRefName,headRefName,state)
    number=$(echo "$info" | jq -r .number)
    base=$(echo "$info" | jq -r .baseRefName)
    head=$(echo "$info" | jq -r .headRefName)
    state=$(echo "$info" | jq -r .state)

    if [[ "$state" != "OPEN" ]]; then
      echo "PR #$number is not open; state=$state"
      return 1
    fi

    if [[ "$base" != "main" ]]; then
      echo "Refusing to merge PR #$number because base is '$base', not 'main'."
      echo "Retarget/rebase the stack first, or merge the bottom PR first."
      return 1
    fi

    # PRs stacked directly on this PR's head bookmark.
    next_prs=$(gh pr list --state open --json number,baseRefName \
      --jq ".[] | select(.baseRefName == \"$head\") | .number")

    gh pr merge "$number" --squash --delete-branch --admin || return 1

    jj git fetch
    jj bookmark set main -r main@origin
    jj new main

    for next in $next_prs; do
      local next_head
      next_head=$(gh pr view "$next" --json headRefName --jq .headRefName)

      echo "Rebasing PR #$next ($next_head) onto main..."
      jj rebase -b "$next_head" -d main
      jj git push -b "$next_head"

      echo "Retargeting PR #$next to main..."
      gh pr edit "$next" --base main
    done
  }

# History configuration
HISTFILE=${HOME}/.zsh_history
HISTSIZE=10000
SAVEHIST=10000

setopt APPEND_HISTORY
setopt INC_APPEND_HISTORY
setopt SHARE_HISTORY

# Paths
if [[ $OSTYPE = (linux)* ]]; then
  export ANDROID_HOME="$HOME/Android/Sdk"
  open() {
    xdg-open "${@:-.}" &>/dev/null
  }
else
  export ANDROID_HOME="$HOME/Library/Android/sdk"
fi
export PATH=$PATH:$ANDROID_HOME/cmdline-tools/latest/bin
export PATH=$PATH:$ANDROID_HOME/emulator
export PATH=$PATH:$ANDROID_HOME/platform-tools

# Google Cloud
export PATH=/opt/homebrew/share/google-cloud-sdk/bin:"$PATH"
# Go
export GOPATH="$HOME/go"
export PATH="$GOPATH/bin:$PATH"
# Local bin
export PATH="$HOME/.local/bin:$PATH"

# Lang
export LC_ALL=en_US.UTF-8
export LANG=en_US.UTF-8

# GitHub Credentials
GITHUB_USERNAME=charliesbot

if [[ "$(uname)" == "Darwin" ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
else
  test -d ~/.linuxbrew && eval "$(~/.linuxbrew/bin/brew shellenv)"
  test -d /home/linuxbrew/.linuxbrew && eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

eval "$(starship init zsh)"
eval "$(zoxide init zsh)"

source $(brew --prefix)/share/zsh-autosuggestions/zsh-autosuggestions.zsh
source $(brew --prefix)/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# Enable FZF if present
if command -v fzf >/dev/null 2>&1; then
  source <(fzf --zsh)
fi

# --files: List files that would be searched but do not search
# --no-ignore: Do not respect .gitignore, etc...
# --hidden: Search hidden files and folders
# --follow: Follow symlinks
# --glob: Additional conditions for search (in this case ignore VCS metadata folders)

export FZF_DEFAULT_COMMAND='rg --files --fixed-strings --hidden --follow --glob "!.git/*" --glob "!.jj/*"'

# OpenCode
export PATH="$HOME/.opencode/bin:$PATH"

# Antigravity
export PATH="$HOME/.antigravity/antigravity/bin:$PATH"

# Rust
export PATH="/opt/homebrew/opt/rustup/bin:$PATH"
export PATH="$HOME/.cargo/bin:$PATH"

# Added by Antigravity IDE
export PATH="$HOME/.antigravity-ide/antigravity-ide/bin:$PATH"
