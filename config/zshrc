# User configuration

export EDITOR='nvim'

# Jujutsu aliases
alias jst='jj status'
alias jin='jj git init --colocate'
alias jdf='jj diff'
alias jft='jj git fetch'
alias jlg='jj log'
alias jps='jj git push'
alias jds='jj describe'
alias jnw='jj new'
alias jsq='jj squash'
alias jsp='jj split'
alias jrb='jj rebase'
alias jrs='jj restore'
alias jab='jj abandon'

# Bookmark management
alias jbl='jj bookmark list'
alias jbc='jj bookmark create'
alias jbm='jj bookmark move'
alias jbd='jj bookmark delete'

jpm() {
  if [[ $# -ne 1 ]]; then
    echo "Usage: jpm <pr-number-or-url>"
    return 2
  fi

  local pr="$1"
  local state

  # 1. Get the current active bookmark name before merging
  local current_bookmark
  current_bookmark=$(jj bookmark list --all | grep -E '\*' | awk '{print $1}')

  # 2. Merge the PR on GitHub
  gh pr merge "$pr" --squash --delete-branch --admin
  state=$(gh pr view "$pr" --json state --jq .state 2>/dev/null || true)

  if [[ "$state" != "MERGED" ]]; then
    echo "PR $pr was not merged."
    return 1
  fi

  # 3. Fetch remote changes and update main
  jj git fetch
  jj bookmark set main -r main@origin

  # 4. Rebase stacked children and push updates to GitHub
  if [[ -n "$current_bookmark" ]]; then
    echo "Rebasing children of $current_bookmark onto main..."
    jj rebase -s "children($current_bookmark)" -d main
    
    echo "Pushing updates to remaining stacked PRs..."
    jj git push
  fi

  # 5. Move to a clean change on top of the updated main
  jj new main
}

# History configuration
HISTFILE=${HOME}/.zsh_history
HISTSIZE=10000
SAVEHIST=10000

setopt APPEND_HISTORY
setopt INC_APPEND_HISTORY
setopt SHARE_HISTORY

# Paths
if [[ $OSTYPE = (linux)* ]]; then
  export ANDROID_HOME="$HOME/Android/Sdk"
  open() {
    xdg-open "${@:-.}" &>/dev/null
  }
else
  export ANDROID_HOME="$HOME/Library/Android/sdk"
fi
export PATH=$PATH:$ANDROID_HOME/cmdline-tools/latest/bin
export PATH=$PATH:$ANDROID_HOME/emulator
export PATH=$PATH:$ANDROID_HOME/platform-tools

# Google Cloud
export PATH=/opt/homebrew/share/google-cloud-sdk/bin:"$PATH"
# Go
export GOPATH="$HOME/go"
export PATH="$GOPATH/bin:$PATH"
# Local bin
export PATH="$HOME/.local/bin:$PATH"

# Lang
export LC_ALL=en_US.UTF-8
export LANG=en_US.UTF-8

# GitHub Credentials
GITHUB_USERNAME=charliesbot

if [[ "$(uname)" == "Darwin" ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
else
  test -d ~/.linuxbrew && eval "$(~/.linuxbrew/bin/brew shellenv)"
  test -d /home/linuxbrew/.linuxbrew && eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

eval "$(starship init zsh)"
eval "$(zoxide init zsh)"

source $(brew --prefix)/share/zsh-autosuggestions/zsh-autosuggestions.zsh
source $(brew --prefix)/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# Enable FZF if present
if command -v fzf >/dev/null 2>&1; then
  source <(fzf --zsh)
fi

# --files: List files that would be searched but do not search
# --no-ignore: Do not respect .gitignore, etc...
# --hidden: Search hidden files and folders
# --follow: Follow symlinks
# --glob: Additional conditions for search (in this case ignore VCS metadata folders)

export FZF_DEFAULT_COMMAND='rg --files --fixed-strings --hidden --follow --glob "!.git/*" --glob "!.jj/*"'

